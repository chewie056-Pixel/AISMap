<Window x:Class="AISAnalysisApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:oxy="clr-namespace:OxyPlot.Wpf;assembly=OxyPlot.Wpf"
        mc:Ignorable="d"
        Title="AIS Tracker - Analyse" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Titre -->
        <TextBlock Grid.Row="0" Text="Analyse des données AIS"
                   FontSize="20" FontWeight="Bold" Margin="0,0,0,10"
                   HorizontalAlignment="Center"/>

        <!-- Contrôles de chargement -->
        <Border Grid.Row="1" Padding="10" Margin="0,0,0,10"
                Background="#F0F0F0" CornerRadius="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Charger JSON" Margin="0,0,10,0"
                        VerticalAlignment="Center" Padding="10,5"
                        Click="LoadJson_Click"/>

                <TextBlock Grid.Column="1" x:Name="txtFileName" Text="Aucun fichier sélectionné"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="2" Content="Analyser" Margin="10,0,0,0"
                        VerticalAlignment="Center" Padding="10,5"
                        Click="Analyze_Click" IsEnabled="False" x:Name="btnAnalyze"/>
            </Grid>
        </Border>

        <!-- Contrôles d'agrégation -->
        <Border Grid.Row="2" Padding="10" Margin="0,0,0,10"
                Background="#F0F0F0" CornerRadius="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Agrégation par:"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>

                <ComboBox Grid.Column="1" x:Name="cmbAggregation" Width="120"
                          VerticalAlignment="Center" Margin="0,0,10,0">
                    <ComboBoxItem Tag="Hour">Heure</ComboBoxItem>
                    <ComboBoxItem Tag="Minutes30" IsSelected="True">30 minutes</ComboBoxItem>
                    <ComboBoxItem Tag="Minutes10">10 minutes</ComboBoxItem>
                    <ComboBoxItem Tag="Minutes2">2 minutes</ComboBoxItem>
                </ComboBox>

                <ComboBox Grid.Column="2" x:Name="cmbChartType" Width="100"
                          VerticalAlignment="Center" Margin="0,0,10,0">
                    <ComboBoxItem Tag="Bar" IsSelected="True">Barres</ComboBoxItem>
                    <ComboBoxItem Tag="Line">Ligne</ComboBoxItem>
                </ComboBox>

                <Button Grid.Column="3" Content="Mettre à jour" HorizontalAlignment="Right"
                        Padding="10,5" Click="UpdateChart_Click"/>
            </Grid>
        </Border>

        <!-- Graphique OxyPlot -->
        <Border Grid.Row="3" Padding="10" Margin="0,0,0,10"
                Background="White" CornerRadius="5"
                BorderThickness="1" BorderBrush="#D0D0D0">
            <oxy:PlotView x:Name="chart"/>
        </Border>

        <!-- Statistiques -->
        <Border Grid.Row="4" Padding="10"
                Background="#F0F0F0" CornerRadius="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="White" Padding="8" Margin="0,0,5,0"
                        CornerRadius="3" BorderThickness="1" BorderBrush="#D0D0D0">
                    <StackPanel>
                        <TextBlock Text="Total bateaux uniques" FontWeight="Bold" FontSize="12"/>
                        <TextBlock x:Name="txtTotalBoats" Text="0" FontSize="16"
                                   HorizontalAlignment="Center" Foreground="Blue"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="White" Padding="8" Margin="5,0,5,0"
                        CornerRadius="3" BorderThickness="1" BorderBrush="#D0D0D0">
                    <StackPanel>
                        <TextBlock Text="Pic maximum" FontWeight="Bold" FontSize="12"/>
                        <TextBlock x:Name="txtMaxBoats" Text="0" FontSize="16"
                                   HorizontalAlignment="Center" Foreground="Red"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="White" Padding="8" Margin="5,0,5,0"
                        CornerRadius="3" BorderThickness="1" BorderBrush="#D0D0D0">
                    <StackPanel>
                        <TextBlock Text="Moyenne" FontWeight="Bold" FontSize="12"/>
                        <TextBlock x:Name="txtAvgBoats" Text="0" FontSize="16"
                                   HorizontalAlignment="Center" Foreground="Green"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Background="White" Padding="8" Margin="5,0,0,0"
                        CornerRadius="3" BorderThickness="1" BorderBrush="#D0D0D0">
                    <StackPanel>
                        <TextBlock Text="Durée" FontWeight="Bold" FontSize="12"/>
                        <TextBlock x:Name="txtDuration" Text="0h" FontSize="16"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
